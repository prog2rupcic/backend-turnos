# Copiar a .env y completar localmente. No versionar .env.

# PostgreSQL propio del servicio (contenedor de Compose).
POSTGRES_DB=turnos
POSTGRES_USER=turnos
POSTGRES_PASSWORD=replace-with-local-password

# Dentro de Compose el host es "db" y el puerto interno 5432.
# Fuera de Compose usar jdbc:postgresql://localhost:5434/turnos.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/turnos
SPRING_DATASOURCE_USERNAME=turnos
SPRING_DATASOURCE_PASSWORD=replace-with-local-password

TURNOS_USER_JWT_SECRET=
# TURNOS_USER_JWT_ISSUER=backend-turnos
# TURNOS_USER_JWT_TTL=PT1H
# TURNOS_USER_JWT_REMEMBER_ME_TTL=P7D

# Dentro de Compose usar http://catalogo-api:8080.
# Fuera de Compose usar http://localhost:8081.
TURNOS_CATALOG_BASE_URL=http://catalogo-api:8080
CATEDRA_REST_URL=
CATEDRA_TECHNICAL_JWT=
# TURNOS_AVAILABILITY_ZONE_ID=America/Argentina/Buenos_Aires
TURNOS_KAFKA_BOOTSTRAP_SERVERS=
TURNOS_KAFKA_CONSUMER_GROUP_ID=
TURNOS_KAFKA_ACTIONS_TOPIC=
TURNOS_KAFKA_PHONE_TOPIC=
TURNOS_INTEGRATION_GROUP_ID=
# TURNOS_OUTBOX_INTERVAL=2000
TURNOS_RECOVERY_ENABLED=true
# TURNOS_RECOVERY_INTERVAL=60000
TURNOS_KAFKA_ENABLED=true
